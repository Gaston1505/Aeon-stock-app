rules_version = '2';

// AEON Stock App now requires login (Firebase Auth, email/password) — these rules only allow
// read/write to a signed-in user. There's no per-user role yet (everyone who has an account
// sees everything), that's a deliberate first step; role-based access is a possible follow-up.
//
// IMPORTANT: only publish this version AFTER an account has been created and sign-in verified
// working in the app — publishing it first would lock everyone out of every collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /equipos/{docId} { allow read, write: if request.auth != null; }
    match /movimientos/{docId} { allow read, write: if request.auth != null; }
    match /entradas/{docId} { allow read, write: if request.auth != null; }
    match /ventas/{docId} { allow read, write: if request.auth != null; }
    match /repuestos/{docId} { allow read, write: if request.auth != null; }
    match /playa/{docId} { allow read, write: if request.auth != null; }
    match /ventasComprometidas/{docId} { allow read, write: if request.auth != null; }
    match /productos/{docId} { allow read, write: if request.auth != null; }
    match /cotizaciones/{docId} { allow read, write: if request.auth != null; }
    match /presupuestosReparacion/{docId} { allow read, write: if request.auth != null; }
    match /clientes/{docId} { allow read, write: if request.auth != null; }
    match /transito/{docId} { allow read, write: if request.auth != null; }
  }
}
