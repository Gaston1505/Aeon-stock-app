rules_version = '2';

// AEON Stock App — Firebase Storage. Mismo esquema de rol que firestore.rules (usuarios/{uid}.rol),
// leído desde acá vía firestore.get(). Usos actuales:
// - Comprobante de cada etapa del cronograma de Tránsito (ver ETAPAS_CRONOGRAMA_TRANSITO en
//   App.jsx), bajo transito/{envioId}/{etapaKey}/{fileName}.
// - Contrato de provisión ya firmado por el cliente (fuera de la app), subido como comprobante
//   bajo contratos/{cotizacionId}/{fileName} (ver ContratoForm/subirContratoFirmado en App.jsx).
// - PDF de respaldo de una fábrica competidora de origen (China) cargada en el comparador de
//   costos, bajo fabricasCompetencia/{fabricaId}/{fileName} (ver ComparadorFabricas/
//   subirPdfFabricaCompetencia en App.jsx). Es solo un adjunto de consulta — los costos se tipean
//   a mano, no se leen del PDF.
// Mismo alcance "solo admin" para todos, igual que las colecciones "transito" y "cotizaciones"
// en Firestore.
//
// IMPORTANTE: este archivo no se despliega solo — no hay paso de CI para Storage Rules (ver
// .github/workflows/deploy.yml, que solo construye y publica el sitio). Hay que pegar este
// contenido a mano en Firebase Console → Storage → Rules, igual que ya se hace con
// firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    function esAdmin() {
      return request.auth != null && (
        !firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == "admin"
      );
    }

    match /transito/{envioId}/{etapaKey}/{fileName} {
      allow read, write: if esAdmin();
    }

    match /contratos/{cotizacionId}/{fileName} {
      allow read, write: if esAdmin();
    }

    match /fabricasCompetencia/{fabricaId}/{fileName} {
      allow read, write: if esAdmin();
    }
  }
}
